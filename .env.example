# 업비트 Open API 키. 출금 권한은 켜지 마세요.
# 사용 예: export UPBIT_ACCESS_KEY="발급받은 액세스 키"
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 기본값은 모의매매입니다. 실주문은 0 으로 두고 python trader.py --live 를 실행하세요.
UPBIT_DRY_RUN=1

# 전략 매개변수 (요청하신 변동성 돌파 예시)
UPBIT_TICKER=KRW-BTC
UPBIT_K=0.5
UPBIT_TAKE_PROFIT=0.03
UPBIT_STOP_LOSS=0.02
UPBIT_INVEST_RATIO=0.5

# 모의매매 시작 원화, 루프 간격(초), 장 마감 직전 신규 매수 금지 시간(분)
UPBIT_PAPER_KRW=1000000
UPBIT_LOOP_SECONDS=1
UPBIT_NO_BUY_MINUTES=5
UPBIT_MIN_ORDER_KRW=5000
